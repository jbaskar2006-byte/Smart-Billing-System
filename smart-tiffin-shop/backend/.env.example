# Smart Tiffin Shop Environment Variables

# Database Configuration
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_tiffin_shop

# Payment Mode Configuration
# Options: development, production
PAYMENT_MODE=development

# Payment Provider Configuration
# Options: simulated, upi_merchant, razorpay, phonepe
PAYMENT_PROVIDER=simulated

# Merchant & Payment Secrets (Never hardcode in source code!)
MERCHANT_ID=test_merchant_123
MERCHANT_KEY=test_key_456
WEBHOOK_SECRET=test_webhook_secret_789
